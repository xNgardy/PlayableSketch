{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:playablesketch:draft-layout:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "playablesketch-layout/1.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "algorithm_version": {
      "type": "string",
      "minLength": 1
    },
    "observation_document_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "source": {
      "$ref": "urn:playablesketch:common:1#/$defs/source"
    },
    "units": {
      "const": "cm"
    },
    "coordinate_system": {
      "const": "local_x_right_y_up_z_up"
    },
    "dimension_basis": {
      "const": "wall_centerline"
    },
    "validation_mode": {
      "enum": [
        "geometry_only",
        "gameplay"
      ]
    },
    "start_room_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "goal_room_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "$ref": "urn:playablesketch:common:1#/$defs/settings"
    },
    "review": {
      "$ref": "urn:playablesketch:common:1#/$defs/review"
    },
    "layout": {
      "$ref": "urn:playablesketch:common:1#/$defs/layout"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "urn:playablesketch:common:1#/$defs/issue"
      },
      "minItems": 0
    },
    "validation": {
      "$ref": "urn:playablesketch:common:1#/$defs/validation"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "kind": {
      "const": "draft_layout"
    },
    "status": {
      "enum": [
        "draft",
        "needs_review",
        "conflicting"
      ]
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "revision_id",
    "parent_revision_id",
    "algorithm_version",
    "observation_document_id",
    "source",
    "units",
    "coordinate_system",
    "dimension_basis",
    "validation_mode",
    "start_room_id",
    "goal_room_id",
    "settings",
    "review",
    "layout",
    "issues",
    "validation",
    "notes",
    "kind",
    "status"
  ],
  "additionalProperties": false
}
