Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico
Saved/
Intermediate/
Plugins/**/Intermediate/
DerivedDataCache/

# Locally generated map build data
*_BuiltData.uasset

# Source art exported or cached during asset production
SourceArt/**/*.png
SourceArt/**/*.tga
