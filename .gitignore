# Visual Studio user-specific files
.vs/

# Compiled object and precompiled-header files
*.slo
*.lo
*.o
*.obj
*.gch
*.pch

# Compiled libraries and executables
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
